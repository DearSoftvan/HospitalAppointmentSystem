@model IEnumerable<HospitalAppointmentSystem.Web.ViewModels.PendingAppointmentViewModel>

@{
    ViewData["Title"] = "Appointment Administration";
}

<h2>Pending Appointments</h2>
<p>Review and manage appointments awaiting approval.</p>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        There are no pending appointments.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Patient</th>
                    <th>Organization</th>
                    <th>Branch</th>
                    <th>Professional</th>
                    <th>Service</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Start.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@item.PatientName</td>
                        <td>@item.OrganizationName</td>
                        <td>@item.BranchName</td>
                        <td>@item.StaffName</td>
                        <td>@item.ServiceName</td>
                        <td>
                            <div class="d-flex gap-2">
                                <form asp-action="Approve" method="post">
                                    <input type="hidden" name="id"
                                           value="@item.Id" />
                                    <button class="btn btn-success btn-sm"
                                            type="submit">Approve</button>
                                </form>

                                <form asp-action="Reject" method="post">
                                    <input type="hidden" name="id"
                                           value="@item.Id" />
                                    <button class="btn btn-danger btn-sm"
                                            type="submit">Reject</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
