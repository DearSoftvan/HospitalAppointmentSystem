@{
    ViewData["Title"] = "Home";
}

<div class="text-center py-5">
    <h1 class="display-4 fw-bold">
        Hospital Appointment System
    </h1>

    <p class="lead text-muted mt-3">
        Book healthcare appointments, view your reservations,
        and manage appointment approvals.
    </p>

    <div class="mt-4">
        @if (User.Identity?.IsAuthenticated == true)
        {
            if (User.IsInRole("Admin"))
            {
                <a asp-controller="Admin"
                   asp-action="Index"
                   class="btn btn-primary btn-lg m-2">
                    Manage Appointments
                </a>
            }
            else
            {
                <a asp-controller="Appointments"
                   asp-action="Create"
                   class="btn btn-primary btn-lg m-2">
                    Book an Appointment
                </a>

                <a asp-controller="Appointments"
                   asp-action="Index"
                   class="btn btn-outline-primary btn-lg m-2">
                    My Appointments
                </a>
            }
        }
        else
        {
            <a asp-controller="Account"
               asp-action="Register"
               class="btn btn-primary btn-lg m-2">
                Create Patient Account
            </a>

            <a asp-controller="Account"
               asp-action="Login"
               class="btn btn-outline-primary btn-lg m-2">
                Sign In
            </a>
        }
    </div>
</div>

<div class="row g-4 mt-3">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Healthcare Services</h5>
                <p class="card-text">
                    Choose a healthcare organization,
                    professional, and service.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Appointment Scheduling</h5>
                <p class="card-text">
                    Select your preferred date and time
                    based on staff availability.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Approval Management</h5>
                <p class="card-text">
                    Support automatic and manual
                    appointment approval policies.
                </p>
            </div>
        </div>
    </div>
</div>
