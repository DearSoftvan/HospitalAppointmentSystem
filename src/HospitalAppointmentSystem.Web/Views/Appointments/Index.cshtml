@model IEnumerable<HospitalAppointmentSystem.Web.ViewModels.AppointmentListItemViewModel>

@{
    ViewData["Title"] = "My Appointments";
}

<h2>My Appointments</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<a asp-action="Create" class="btn btn-primary mb-3">
    New Appointment
</a>

@if (!Model.Any())
{
    <div class="alert alert-info">
        You do not have any appointments yet.
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Date</th>
                <th>Time</th>
                <th>Branch</th>
                <th>Professional</th>
                <th>Service</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Start.ToString("yyyy-MM-dd")</td>
                    <td>@item.Start.ToString("HH:mm")</td>
                    <td>@item.BranchName</td>
                    <td>@item.StaffName</td>
                    <td>@item.ServiceName</td>
                    <td>@item.Status</td>
                </tr>
            }
        </tbody>
    </table>
}
