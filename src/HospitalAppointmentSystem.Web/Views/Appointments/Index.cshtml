@model IEnumerable<HospitalAppointmentSystem.Web.ViewModels.AppointmentListItemViewModel>

@{
    ViewData["Title"] = "My Appointments";
}

<h2>My Appointments</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<a asp-action="Create" class="btn btn-primary mb-3">
    New Appointment
</a>

@if (!Model.Any())
{
    <div class="alert alert-info">
        You do not have any appointments yet.
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Date</th>
                <th>Time</th>
                <th>Branch</th>
                <th>Professional</th>
                <th>Service</th>
                <th>Status</th>
                <th>History</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Start.ToString("yyyy-MM-dd")</td>
                    <td>@item.Start.ToString("HH:mm")</td>
                    <td>@item.BranchName</td>
                    <td>@item.StaffName</td>
                    <td>@item.ServiceName</td>
                    <td>@item.Status</td>
                    <td>
                        <a asp-controller="Appointments"
                           asp-action="History"
                           asp-route-id="@item.Id"
                           class="btn btn-outline-primary btn-sm">
                            History
                        </a>
                    </td>
                    <td>
                        @if (item.Status == "Pending" ||
                                 item.Status == "Approved")
                            {
                                <form asp-controller="Appointments"
                                      asp-action="Cancel"
                                      method="post"
                                      onsubmit="return confirm('Cancel this appointment?');">
                        
                                    <input type="hidden"
                                           name="id"
                                           value="@item.Id" />

                                    <button type="submit"
                                            class="btn btn-outline-danger btn-sm">
                                        Cancel
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                </tr>
            }
        </tbody>
    </table>
}
