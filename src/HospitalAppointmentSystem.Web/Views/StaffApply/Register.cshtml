@model HospitalAppointmentSystem.Web.ViewModels.StaffApplicationViewModel
@using HospitalAppointmentSystem.Domain.Enums

@{
    ViewData["Title"] = "Healthcare Staff Application";
}

<h2>Healthcare Staff Application</h2>

<p class="text-muted">
    Apply to join a healthcare organization.
    Your application must be approved by an administrator.
</p>

<form asp-action="Register" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword" class="form-control" />
        <span asp-validation-for="ConfirmPassword"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="BranchId" class="form-label"></label>
        <select asp-for="BranchId"
                asp-items="Model.Branches"
                class="form-select">
            <option value="0">Select branch</option>
        </select>
        <span asp-validation-for="BranchId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Profession" class="form-label"></label>
        <select asp-for="Profession" class="form-select">
            <option value="1">Doctor</option>
            <option value="2">Nurse</option>
            <option value="3">Laboratory Technician</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Specialty" class="form-label"></label>
        <input asp-for="Specialty"
               class="form-control"
               placeholder="e.g. Neurology" />
        <span asp-validation-for="Specialty" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Submit Application
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
